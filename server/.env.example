# Backend Port
PORT=8000

# Secret key used for signing JWT tokens (REQUIRED: Server will refuse to start without it)
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL for CORS (comma-separated if multiple, e.g. http://localhost:5173,https://myresumeapp.com)
CLIENT_URL=http://localhost:5173

# Node Environment (development | production | test)
NODE_ENV=development
